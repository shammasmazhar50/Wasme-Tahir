# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Environment and App URL
NODE_ENV=production
PORT=6002
API_URL=https://api.wasmetahir.com

# 2. CORS - The exact URL where your Cloudflare frontend is hosted
FRONTEND_URL=https://wasmetahir.com

# 3. Security Secrets
# Generate a secure 64 character hex string for this in production
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# 4. Database Config (MySQL on Hostinger)
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
